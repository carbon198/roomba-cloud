# Docker translates these values into `python -m roomba_cloud` CLI flags. No JSON is needed.
# Compose image only; release downloads pin this to their version.
ROOMBA_IMAGE=ghcr.io/carbon198/roomba-cloud:latest
PUBLIC_URL=https://roomba.example.com

# Container state is persisted at /data. Keep custom paths under this mount.
DATA_DIR=/data
# Empty means DATA_DIR/customer-token.txt, generated automatically on first run.
CUSTOMER_TOKEN_FILE=
BIND=0.0.0.0
HTTPS_PORT=8443
MQTT_PORT=8883
# Compose-only host port mappings:
HTTPS_HOST_PORT=443
MQTT_HOST_PORT=8883

# Choose supplied certificates OR built-in ACME, never both.
# Paths are inside the container; ./certs is mounted read-only at /certs.
TLS_CERT=
TLS_KEY=

# Optional built-in Let's Encrypt manual DNS-01 provisioning.
# Uses the PUBLIC_URL hostname; email + terms acceptance enable ACME.
# Leave TLS_CERT/TLS_KEY empty for ACME.
ACME_EMAIL=
# Set true only after reviewing and accepting the Let's Encrypt terms.
ACME_AGREE_TOS=false
# Staging certificates are not trusted by robots or Home Assistant.
ACME_STAGING=false
